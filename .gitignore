# Dependencies
node_modules/
.pnpm-store/

# Test sandbox and probe leftovers (rebuilt by tests/run.mjs)
tests/.sandbox/
output/_scan/.verify-backup/
output/_scan/.asset-probe/

# Build output that is generated, not authored
packages/plugin/lib/client.js.bak
*.log

# Local data a user generates while running the plugin.
# `skins/*` ignores the entries, not the directory itself, so the tracked demos
# below can be re-included. (`skins/` would ignore the directory and Git would
# never descend into it — the demos then silently vanish from the repository.)
skins/*
!skins/demo/
!skins/demo/**

# Exports and temporary archives
*.zip
*.tar.gz
output/
exports/
trash/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
